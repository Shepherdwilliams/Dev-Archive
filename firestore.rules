rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to identify the verified site owner
    function isOwner() {
      return request.auth != null && 
        request.auth.token.email.lower() == 'wordswithoutwallspublishing@gmail.com';
    }

    // Users collection: users manage their own profile, owner has administrative read
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isOwner());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User Progress collection: users manage their own progress, owner has audit read
    match /user_progress/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isOwner());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Site Configuration: public can read, ONLY owner can write/configure
    match /site_config/{configId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Published Articles: public can read, ONLY owner can create, update, or delete
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
