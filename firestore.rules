rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection rules: users can read and write only their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User Progress collection rules: users can read and write only their own progress record
    match /user_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
