{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User account profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "user_progress": {
      "title": "User Progress",
      "description": "User lesson and quiz progress tracking",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lastCompletedStepId": { "type": "string" },
        "lastCompletedModuleId": { "type": "string" },
        "completionPercentage": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "customDataJson": { "type": "string" },
        "completedLessonIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "completedQuizIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["userId"]
    },
    "site_config": {
      "title": "Site Configuration",
      "description": "Owner managed site settings, announcements, and feature toggles",
      "type": "object",
      "properties": {
        "tickerNotice": { "type": "string" },
        "broadcastActive": { "type": "boolean" },
        "broadcastMessage": { "type": "string" },
        "aiChatEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    },
    "articles": {
      "title": "Published STEM News Articles",
      "description": "Accredited daily articles curated and published by the site owner",
      "type": "object",
      "properties": {
        "headline": { "type": "string" },
        "deck": { "type": "string" },
        "discipline": { "type": "string" },
        "content": { "type": "string" },
        "citations": { "type": "array" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "publishedBy": { "type": "string" }
      },
      "required": ["headline", "content"]
    },
    "service_bookings": {
      "title": "Service Bookings",
      "description": "In-person class and consulting service booking registrations",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string" },
        "service": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientPhone": { "type": "string" },
        "location": { "type": "string" },
        "preferredDate": { "type": "string" },
        "groupSize": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingId", "service", "clientName", "clientEmail"]
    }
  }
}
