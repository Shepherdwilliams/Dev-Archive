# ==========================================
# Production Environment Variables Guide
# ==========================================

# 1. Google Gemini API Key (Server-Side Proxy Requirement)
# Get your API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Printify Store Integration (Optional - for merchandise store)
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# 3. Environment & Node Settings
NODE_ENV=production
