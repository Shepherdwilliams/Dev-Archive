# ==========================================
# Production Environment Variables Guide
# ==========================================

# 1. Google Gemini API Key (Server-Side Proxy Requirement)
# Get your API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Printify Store Integration (Optional - for merchandise store)
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# 3. Environment & Node Settings
NODE_ENV=production

# 4. Site Owner / Admin Authorization
ADMIN_EMAIL=wordswithoutwallspublishing@gmail.com
ADMIN_SECRET_KEY=

# 5. Email & Booking Dispatch Notifications (Optional SMTP / Gmail App Password or Resend)
# To automatically dispatch emails from the server:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=wordswithoutwallspublishing@gmail.com
SMTP_PASS=
# Alternatively, Resend API key:
RESEND_API_KEY=
RESEND_FROM=Development Archive <onboarding@resend.dev>
